{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "甬勒ERP",
  "mainBinaryName": "甬勒ERP",
  "version": "0.1.1",
  "identifier": "cn.nbyongle.erp.desktop",
  "app": {
    "withGlobalTauri": false,
    "windows": []
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "宁波甬勒包装制品有限公司",
    "shortDescription": "甬勒ERP 客户端",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../config/app.json": "config/app.json",
      "../pages/index.html": "pages/index.html",
      "../pages/offline.css": "pages/offline.css",
      "../pages/splash.html": "pages/splash.html",
      "../pages/splash.css": "pages/splash.css"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
