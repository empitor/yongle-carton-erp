# 示例；程序不会自动加载.env。Windows PowerShell示例：$env:NODE_ENV='production'; npm start
# 正式部署务必设置生产环境；开发者编辑模式在生产环境不可开启。
NODE_ENV=production
ERP_DEVELOPER_MODE=0
PORT=3001
# 开发前端端口；PORT也同时用于Vite的API代理。
WEB_PORT=5173
# API地址、模型和密钥通过网页配置；此文件不得填写密钥。

# 可选：覆盖平台默认凭据目录；Linux 服务账号独占（0700），绝不放进业务备份目录。
# ERP_CONFIG_DIR=/var/lib/yongle-carton-erp/config
# ERP_BACKUP_DIR=/var/lib/yongle-carton-erp/backups
