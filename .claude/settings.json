{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(npm run patch-server *)",
      "Bash(npm run package *)",
      "Bash(gh release create *)",
      "Bash(gh release upload *)",
      "Bash(gh release edit *)",
      "Bash(gh release delete *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm add *)",
      "Bash(cargo add *)",
      "Bash(npm stop *)",
      "Bash(npm run stop *)",
      "Bash(node scripts/ui-check/real-smoke.mjs *)",
      "Bash(node scripts/ui-check/real-suite.mjs *)",
      "PowerShell(git push *)",
      "PowerShell(git tag *)",
      "PowerShell(npm run patch-server *)",
      "PowerShell(npm run package *)",
      "PowerShell(gh release create *)",
      "PowerShell(gh release upload *)",
      "PowerShell(gh release edit *)",
      "PowerShell(gh release delete *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(npm add *)",
      "PowerShell(cargo add *)",
      "PowerShell(npm stop *)",
      "PowerShell(npm run stop *)",
      "PowerShell(node scripts/ui-check/real-smoke.mjs *)",
      "PowerShell(node scripts/ui-check/real-suite.mjs *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Glob|Grep|Bash|PowerShell|WebFetch|mcp__Claude_Browser__navigate|mcp__Claude_Browser__preview_start|mcp__Claude_Browser__browser_batch|mcp__Claude_Browser__javascript_tool|mcp__remote-devices__Claude_Browser__navigate|mcp__remote-devices__Claude_Browser__preview_start|mcp__remote-devices__Claude_Browser__browser_batch|mcp__remote-devices__Claude_Browser__javascript_tool|mcp__claude-in-chrome__navigate|mcp__claude-in-chrome__browser_batch|mcp__claude-in-chrome__javascript_tool",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-real-data.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/file-size-reminder.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
