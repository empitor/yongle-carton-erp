NODE_ENV=production
ERP_DEPLOYMENT=1
PORT=3001
ERP_PROXY_PORT=3002
ERP_ALLOWED_HOSTS=erp.example.invalid
ERP_ALLOWED_ORIGINS=https://erp.example.invalid
DB_PATH=/var/lib/yongle-carton-erp/data/erp.sqlite
ERP_BACKUP_DIR=/var/lib/yongle-carton-erp/backups
ERP_CONFIG_DIR=/var/lib/yongle-carton-erp/config
# 离机复制位置必须在 data 和 backups 之外，并在 systemd ReadWritePaths 中放行。
# ERP_BACKUP_COPY_DIR=/mnt/erp-offsite
# ERP_BACKUP_COPY_KEEP=30
